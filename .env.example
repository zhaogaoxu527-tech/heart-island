# ============================================================
#  心屿 · AI 女友  环境配置示例
#  使用方法：复制为 .env 后填写。.env 已被 .gitignore 排除。
# ============================================================

# ---------- 服务运行 ----------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=false
# 生产环境请替换为随机长字符串，建议：
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret
# 仅在 HTTPS 部署时改为 true
SESSION_COOKIE_SECURE=false

# ---------- SQLite ----------
# 相对路径以项目根目录为基准；无需安装任何数据库软件
DATABASE_PATH=data/heart_island.db

# ---------- Kimi（Moonshot）API ----------
# 密钥只放服务端，前端永远不可见
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k3
KIMI_TIMEOUT=60
KIMI_MAX_TOKENS=800

# 模型调用失败时是否自动使用内置角色回复（推荐 true）
KIMI_FALLBACK_LOCAL=true

# 带给模型的历史消息上限与字符预算
KIMI_HISTORY_LIMIT=24
KIMI_HISTORY_CHAR_BUDGET=12000
